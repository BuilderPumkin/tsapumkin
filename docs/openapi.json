  "info": {
    "description": "Microservice tính toán tất định và kiểm định toán học cho PUMKIN.DEV",
    "title": "Pumkin Math API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Public health check endpoint returning service, SymPy, and Python runtime versions.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Kiểm tra trạng thái hoạt động và phiên bản hệ thống",
        "tags": [
          "System"
        ]
      }
    },
    "/v1/check": {
      "post": {
        "description": "Submission checker endpoint.\nEvaluates student answer or intermediate step transformation with sequential\nsymbolic and numeric pipeline.",
        "operationId": "check_endpoint_v1_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Pumkin-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Pumkin-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            },
            "description": "Kết quả chấm bài và đánh giá bước giải"
          },
          "401": {
            "description": "Chưa xác thực hoặc khóa không hợp lệ"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chấm bài thi & Đánh giá bước giải",
        "tags": [
          "Core"
        ]
      }
    },
    "/v1/generate": {
      "post": {
        "description": "Deterministic question generator endpoint with circle verification\nand misconception-driven distractors.",
        "operationId": "generate_endpoint_v1_generate_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Pumkin-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Pumkin-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Chưa xác thực hoặc khóa không hợp lệ"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tạo đề & Sinh biến thể câu hỏi tương đương",
        "tags": [
          "Core"
        ]
      }
    },
    "/v1/solve": {
      "post": {
        "description": "Socratic solver endpoint.\nTranslates Vietnamese natural-language problem to DSL using consensus mechanism\nand evaluates via deterministic CAS solvers.",
        "operationId": "solve_endpoint_v1_solve_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Pumkin-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Pumkin-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolveResponse"
                }
              }
            },
            "description": "Kết quả giải toán và gợi ý sư phạm Socratic"
          },
          "401": {
            "description": "Chưa xác thực hoặc khóa không hợp lệ"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Gia sư AI giải toán Socratic 4 bậc",
        "tags": [
          "Core"
        ]
      }
    },
    "/version": {
      "get": {
        "description": "Public version endpoint returning microservice, prompt parser, CAS solver, and commit hash.",
        "operationId": "version_check_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Lấy chi tiết phiên bản dịch vụ, prompt parser, bộ giải CAS và git commit",
        "tags": [
          "System"
        ]
      }
    }
  }
}
