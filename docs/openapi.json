{
  "components": {
    "schemas": {
      "AnswerTypeEnum": {
        "enum": [
          "number",
          "expression",
          "interval",
          "set",
          "matrix",
          "boolean_group",
          "multiple_choice",
          "drag_drop",
          "step_solution"
        ],
        "title": "AnswerTypeEnum",
        "type": "string"
      },
      "CheckRequest": {
        "additionalProperties": false,
        "description": "Input payload for student answer or intermediate step checking.\nRequires question text or DSL, canonical answer, student answer, and answer type.",
        "properties": {
          "answer_type": {
            "$ref": "#/components/schemas/AnswerTypeEnum",
            "description": "Kiểu dữ liệu của đáp án (number, expression, interval, set, drag_drop, step_solution...)"
          },
          "canonical_answer": {
            "description": "Đáp án chuẩn của ngân hàng đề hoặc giáo viên",
            "maxLength": 500,
            "minLength": 1,
            "title": "Canonical Answer",
            "type": "string"
          },
          "question_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mã câu hỏi trong ngân hàng đề",
            "title": "Question Id"
          },
          "question_text": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Đề bài bằng chữ nếu có",
            "title": "Question Text"
          },
          "step_index": {
            "anyOf": [
              {
                "maximum": 20.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Số thứ tự bước giải nếu kiểm tra theo từng bước",
            "title": "Step Index"
          },
          "student_answer": {
            "description": "Đáp án hoặc biểu thức bước biến đổi của học sinh",
            "maxLength": 500,
            "minLength": 1,
            "title": "Student Answer",
            "type": "string"
          }
        },
        "required": [
          "canonical_answer",
          "student_answer",
          "answer_type"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResponse": {
        "additionalProperties": false,
        "description": "Standardized envelope response for POST /v1/check.",
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceInfo",
            "description": "Thông tin mức độ tin cậy và phương pháp kiểm chứng"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thông tin lỗi chi tiết nếu status == 'error'"
          },
          "restate_vi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thuật lại đề bài toán học đã chuẩn hóa bằng tiếng Việt",
            "title": "Restate Vi"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckResultPayload"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dữ liệu kết quả chi tiết của từng endpoint cụ thể"
          },
          "schema_version": {
            "default": "1.1.0",
            "description": "Phiên bản schema hợp đồng dữ liệu",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum",
            "description": "Trạng thái xác thực toán học của phản hồi"
          },
          "steps": {
            "description": "Danh sách các bước biến đổi trung gian (nếu có)",
            "items": {
              "$ref": "#/components/schemas/StepItem"
            },
            "title": "Steps",
            "type": "array"
          },
          "trace_id": {
            "description": "Mã truy vết duy nhất của request (UUIDv4)",
            "title": "Trace Id",
            "type": "string"
          },
          "unsupported_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UnsupportedReasonEnum"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mã định danh lý do không hỗ trợ (bắt buộc khi status == 'unsupported')"
          },
          "warnings": {
            "description": "Danh sách cảnh báo toán học có cấu trúc (mã chuẩn và lời giải thích)",
            "items": {
              "$ref": "#/components/schemas/WarningItem"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "status",
          "confidence"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "CheckResultPayload": {
        "additionalProperties": false,
        "description": "Specific result payload for submission checking.",
        "properties": {
          "canonical_answer": {
            "description": "Đáp án chuẩn trích xuất từ ngân hàng đề hoặc đề bài gốc",
            "title": "Canonical Answer",
            "type": "string"
          },
          "canonical_latex": {
            "description": "Đáp án chuẩn định dạng KaTeX chuẩn hóa",
            "title": "Canonical Latex",
            "type": "string"
          },
          "cas_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Đáp án do SymPy CAS tính toán độc lập (nếu giải được tất định)",
            "title": "Cas Answer"
          },
          "conflict": {
            "default": false,
            "description": "Cờ đánh dấu có sự mâu thuẫn giữa đáp án ngân hàng gốc và kết quả tính của CAS. Khi conflict=True, verdict bắt buộc là cannot_determine và KHÔNG trừ điểm học sinh.",
            "title": "Conflict",
            "type": "boolean"
          },
          "detected_misconception_id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MisconceptionTrapEnum"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mã bẫy nhận thức chuẩn GEMINI.md phát hiện được nếu học sinh làm sai"
          },
          "feedback_vi": {
            "description": "Nhận xét phản hồi sư phạm bằng tiếng Việt",
            "title": "Feedback Vi",
            "type": "string"
          },
          "is_correct": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cờ logic boolean (True nếu đúng/khác dạng, False nếu sai, None nếu không xác định)",
            "title": "Is Correct"
          },
          "student_latex": {
            "description": "Đáp án học sinh định dạng KaTeX chuẩn hóa",
            "title": "Student Latex",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/CheckVerdictEnum",
            "description": "Kết luận kiểm định: correct, correct_different_form, incorrect, cannot_determine"
          }
        },
        "required": [
          "verdict",
          "canonical_answer",
          "feedback_vi",
          "canonical_latex",
          "student_latex"
        ],
        "title": "CheckResultPayload",
        "type": "object"
      },
      "CheckVerdictEnum": {
        "enum": [
          "correct",
          "correct_different_form",
          "incorrect",
          "cannot_determine"
        ],
        "title": "CheckVerdictEnum",
        "type": "string"
      },
      "ConfidenceInfo": {
        "additionalProperties": false,
        "properties": {
          "level": {
            "$ref": "#/components/schemas/ConfidenceLevel",
            "description": "Mức độ tin cậy định tính (high, medium, low)"
          },
          "method": {
            "$ref": "#/components/schemas/ConfidenceMethod",
            "description": "Phương pháp kiểm chứng (symbolic, numeric, consensus)"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Điểm số tin cậy định lượng (0.0 đến 1.0)",
            "title": "Score"
          }
        },
        "required": [
          "level",
          "method"
        ],
        "title": "ConfidenceInfo",
        "type": "object"
      },
      "ConfidenceLevel": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "ConfidenceLevel",
        "type": "string"
      },
      "ConfidenceMethod": {
        "enum": [
          "symbolic",
          "numeric",
          "consensus"
        ],
        "title": "ConfidenceMethod",
        "type": "string"
      },
      "DifficultyEnum": {
        "enum": [
          "M1",
          "M2",
          "M3",
          "M4"
        ],
        "title": "DifficultyEnum",
        "type": "string"
      },
      "DistractorItem": {
        "additionalProperties": false,
        "description": "Represents a scientifically designed distractor option based on student misconception traps.",
        "properties": {
          "explanation_vi": {
            "description": "Giải thích nguyên nhân học sinh mắc phải sai lầm này",
            "title": "Explanation Vi",
            "type": "string"
          },
          "latex": {
            "description": "Nội dung phương án sai định dạng KaTeX",
            "title": "Latex",
            "type": "string"
          },
          "misconception_id": {
            "$ref": "#/components/schemas/MisconceptionTrapEnum",
            "description": "Mã định danh bẫy nhận thức chuẩn GEMINI.md (vd: TRAP_EXTREMA_DELTA_CONFUSION, TRAP_LOG_DOMAIN_IGNORED)"
          },
          "option_index": {
            "description": "Chỉ số vị trí phương án (0..5)",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Option Index",
            "type": "integer"
          }
        },
        "required": [
          "option_index",
          "latex",
          "misconception_id",
          "explanation_vi"
        ],
        "title": "DistractorItem",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Mã lỗi hệ thống chuẩn (vd: INVALID_DSL, TIMEOUT)",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thông tin chẩn đoán kỹ thuật bổ sung",
            "title": "Details"
          },
          "message_vi": {
            "description": "Mô tả lỗi bằng tiếng Việt cho học sinh/người dùng",
            "title": "Message Vi",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message_vi"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "GenerateRequest": {
        "additionalProperties": false,
        "description": "Input payload for deterministic problem generation.\nEnforces bounds on count, seed, and valid difficulty levels.",
        "properties": {
          "category": {
            "description": "Mã dạng bài toán học chuẩn (vd: ham_so_cuc_tri_cho_truoc, hinh_hoc_oxyz)",
            "maxLength": 100,
            "minLength": 2,
            "title": "Category",
            "type": "string"
          },
          "count": {
            "default": 1,
            "description": "Số lượng câu hỏi cần sinh (1 đến 20)",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "difficulty": {
            "$ref": "#/components/schemas/DifficultyEnum",
            "default": "M2",
            "description": "Độ khó chuẩn hóa: M1 (Nhận biết), M2 (Thông hiểu), M3 (Vận dụng), M4 (Vận dụng cao)"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 2147483647.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hạt giống giả ngẫu nhiên cố định để tái lập kết quả sinh tất định",
            "title": "Seed"
          },
          "use_llm": {
            "default": false,
            "description": "Tùy chọn dùng LLM để diễn đạt lại lời văn đề (vẫn giữ nguyên số liệu)",
            "title": "Use Llm",
            "type": "boolean"
          }
        },
        "required": [
          "category"
        ],
        "title": "GenerateRequest",
        "type": "object"
      },
      "GenerateResponse": {
        "additionalProperties": false,
        "description": "Standardized envelope response for POST /v1/generate.",
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceInfo",
            "description": "Thông tin mức độ tin cậy và phương pháp kiểm chứng"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thông tin lỗi chi tiết nếu status == 'error'"
          },
          "restate_vi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Thuật lại đề bài toán học đã chuẩn hóa bằng tiếng Việt",
            "title": "Restate Vi"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerateResultPayload"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dữ liệu kết quả chi tiết của từng endpoint cụ thể"
          },
          "schema_version": {
            "default": "1.1.0",
            "description": "Phiên bản schema hợp đồng dữ liệu",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum",
            "description": "Trạng thái xác thực toán học của phản hồi"
          },
          "steps": {
            "description": "Danh sách các bước biến đổi trung gian (nếu có)",
            "items": {
              "$ref": "#/components/schemas/StepItem"
            },
            "title": "Steps",
            "type": "array"
          },
          "trace_id": {
            "description": "Mã truy vết duy nhất của request (UUIDv4)",
            "title": "Trace Id",
            "type": "string"
          },
          "unsupported_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UnsupportedReasonEnum"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mã định danh lý do không hỗ trợ (bắt buộc khi status == 'unsupported')"
          },
          "warnings": {
            "description": "Danh sách cảnh báo toán học có cấu trúc (mã chuẩn và lời giải thích)",
            "items": {
              "$ref": "#/components/schemas/WarningItem"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "status",
          "confidence"
        ],
        "title": "GenerateResponse",
        "type": "object"
      },
      "GenerateResultPayload": {
        "additionalProperties": false,
        "description": "Specific result payload for question generation.",
        "properties": {
          "count": {
            "description": "Số lượng câu hỏi đã sinh thành công",
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "questions": {
            "description": "Danh sách các câu hỏi toán học hoàn chỉnh",
            "items": {
              "$ref": "#/components/schemas/GeneratedQuestionItem"
            },
            "title": "Questions",
            "type": "array"
          }
        },
        "required": [
          "count",
          "questions"
        ],
        "title": "GenerateResultPayload",
        "type": "object"
      },
      "GeneratedQuestionItem": {
        "additionalProperties": false,
        "description": "Complete generated question representation.",
        "properties": {
          "category": {
            "description": "Dạng bài toán học",
            "title": "Category",
            "type": "string"
          },
          "correct_answer": {
            "description": "Nội dung đáp án đúng",
            "title": "Correct Answer",
            "type": "string"
          },
          "correct_index": {
            "description": "Chỉ số vị trí của đáp án đúng trong mảng options",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Correct Index",
            "type": "integer"
          },
          "difficulty": {
            "$ref": "#/components/schemas/DifficultyEnum",
            "description": "Độ khó câu hỏi"
          },
          "difficulty_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Điểm độ khó ước lượng theo quy tắc (Rule-based, chưa phải hiệu chuẩn Rasch)",
            "title": "Difficulty Score"
          },
          "distractors": {
            "description": "Danh sách các phương án nhiễu kèm mã bẫy nhận thức",
            "items": {
              "$ref": "#/components/schemas/DistractorItem"
            },
            "title": "Distractors",
            "type": "array"
          },
          "explanation_vi": {
            "description": "Lời giải chi tiết bằng tiếng Việt",
            "title": "Explanation Vi",
            "type": "string"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mã băm SHA-256 đề bài chuẩn hóa phục vụ khử trùng lặp",
            "title": "Hash"
          },
          "id": {
            "description": "Mã định danh duy nhất của câu hỏi được sinh",
            "title": "Id",
            "type": "string"
          },
          "options": {
            "description": "Danh sách các phương án lựa chọn",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 2,
            "title": "Options",
            "type": "array"
          },
          "question_text": {
            "description": "Văn bản đề bài kèm công thức KaTeX",
            "title": "Question Text",
            "type": "string"
          },
          "skills": {
            "description": "Kỹ năng toán học cần đánh giá",
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array"
          },
          "socratic_hints": {
            "description": "Thang gợi ý Socratic 4 bậc",
            "items": {
              "type": "string"
            },
            "title": "Socratic Hints",
            "type": "array"
          },
          "subtopic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chuyên đề chi tiết",
            "title": "Subtopic"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chủ đề toán học phân loại",
            "title": "Topic"
          }
        },
        "required": [
          "id",
          "category",
          "difficulty",
          "question_text",
          "options",
          "correct_answer",
          "correct_index",
          "explanation_vi"
        ],
        "title": "GeneratedQuestionItem",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "python_version": {
            "description": "Phiên bản Python runtime",
            "title": "Python Version",
            "type": "string"
          },
          "service_version": {
            "description": "Phiên bản microservice",
            "title": "Service Version",
            "type": "string"
          },
          "status": {
            "default": "healthy",
            "description": "Trạng thái dịch vụ",
            "title": "Status",
            "type": "string"
          },
          "sympy_version": {
            "description": "Phiên bản SymPy CAS",
            "title": "Sympy Version",
            "type": "string"
          }
        },
        "required": [
          "service_version",
          "sympy_version",
          "python_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HintItem": {
        "additionalProperties": false,
        "description": "Socratic scaffolding hint item.",
        "properties": {
          "content_vi": {
            "description": "Nội dung sư phạm hướng dẫn",
            "title": "Content Vi",
            "type": "string"
          },
          "latex_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Công thức gợi ý toán học định dạng KaTeX \\( ... \\) hoặc \\[ ... \\]",
            "title": "Latex Hint"
          },
          "level": {
            "description": "Bậc gợi ý Socratic (1: Nudge, 2: Concept, 3: Sub-goal, 4: Worked Step)",
