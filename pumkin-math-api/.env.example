# PUMKIN MATH API - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# TUYỆT ĐỐI KHÔNG commit tệp .env thật chứa thông tin nhạy cảm vào kho Git.

# Cấu hình dịch vụ máy chủ
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Danh sách mã băm SHA-256 (64 ký tự hex viết thường, phân tách bởi dấu phẩy nếu có nhiều khóa)
# Sinh khóa mới và lấy mã băm bằng lệnh: python tools/make_api_key.py
# TUYỆT ĐỐI KHÔNG dán khóa thô (plain-text) vào đây.
PUMKIN_API_KEY_HASHES=REPLACE_WITH_SHA256_HEX_HASH_FROM_TOOLS_MAKE_API_KEY
