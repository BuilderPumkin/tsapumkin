# CẤU HÌNH BIẾN MÔI TRƯỜNG CLOUDFLARE PAGES (VÍ DỤ MẪU)
# TUYỆT ĐỐI KHÔNG ĐIỀN API KEY THẬT VÀO FILE NÀY KHI COMMIT LÊN GITHUB!
#
# Khi triển khai lên Cloudflare Pages, bạn sẽ thêm biến bí mật này tại:
# Cloudflare Dashboard > Workers & Pages > Chọn dự án > Settings > Variables and Secrets

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AUTH_SECRET=your_custom_jwt_secret_here