# CẤU HÌNH BIẾN MÔI TRƯỜNG CLOUDFLARE PAGES (VÍ DỤ MẪU)
# TUYỆT ĐỐI KHÔNG ĐIỀN API KEY THẬT VÀO FILE NÀY KHI COMMIT LÊN GITHUB!
#
# Khi triển khai lên Cloudflare Pages, bạn thêm biến bí mật tại:
# Cloudflare Dashboard > Workers & Pages > Chọn dự án 'tsapumkin' > Settings > Variables and Secrets
#
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AUTH_SECRET=your_custom_jwt_secret_here
